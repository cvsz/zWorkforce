<Page
    x:Class="ZWorkforceClient.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{ThemeResource PagePaddingThickness}" Spacing="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="OVERVIEW" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Control plane health" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="OnRefreshClick" />
            </Grid>

            <InfoBar x:Name="OverviewInfo" IsOpen="False" IsClosable="False" />
            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Left" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel><TextBlock Text="ACTIVE TASKS" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="ActiveTasksText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel><TextBlock Text="TASKS / 24H" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="Tasks24hText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel><TextBlock Text="SUCCESS RATE" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="SuccessRateText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel><TextBlock Text="DEAD LETTERS" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="DeadLettersText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="10"><TextBlock Text="PROVIDERS" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView x:Name="ProvidersList" IsItemClickEnabled="False" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="10"><TextBlock Text="RECENT TASKS" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView x:Name="RecentTasksList" IsItemClickEnabled="False" /></StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
