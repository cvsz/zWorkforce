<Window
    x:Class="ZWorkforceClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="zWorkforce Client">
    <NavigationView
        x:Name="RootNavigationView"
        AlwaysShowHeader="False"
        Background="{ThemeResource ZwfCanvasBrush}"
        CompactPaneLength="56"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="264"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="OnNavigationSelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Margin="14,18,12,18" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border
                        Width="32"
                        Height="32"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="9">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="White"
                            Glyph="&#xE950;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="zWorkforce" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource ZwfMutedTextBrush}"
                            Text="AI CONTROL PLANE" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Connection" Tag="connection">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Overview" Tag="overview">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Tasks" Tag="tasks">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Agents" Tag="agents">
                <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Automation" Tag="automation">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Knowledge" Tag="knowledge">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Governance" Tag="governance">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" Background="{ThemeResource ZwfCanvasBrush}" />
    </NavigationView>
</Window>
