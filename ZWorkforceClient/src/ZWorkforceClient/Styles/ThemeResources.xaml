<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ZwfCanvasBrush" Color="#F6F8FB" />
            <SolidColorBrush x:Key="ZwfSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ZwfSurfaceMutedBrush" Color="#FFF0F4F8" />
            <SolidColorBrush x:Key="ZwfHeroBrush" Color="#FFEAF2FF" />
            <SolidColorBrush x:Key="ZwfStrokeBrush" Color="#1A172033" />
            <SolidColorBrush x:Key="ZwfMutedTextBrush" Color="#A61C2738" />
            <SolidColorBrush x:Key="ZwfSuccessBrush" Color="#FF0A7B55" />
            <SolidColorBrush x:Key="ZwfWarningBrush" Color="#FF9A5B00" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ZwfCanvasBrush" Color="#FF0A0F18" />
            <SolidColorBrush x:Key="ZwfSurfaceBrush" Color="#FF111927" />
            <SolidColorBrush x:Key="ZwfSurfaceMutedBrush" Color="#FF172233" />
            <SolidColorBrush x:Key="ZwfHeroBrush" Color="#FF102743" />
            <SolidColorBrush x:Key="ZwfStrokeBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ZwfMutedTextBrush" Color="#B8D7E1EE" />
            <SolidColorBrush x:Key="ZwfSuccessBrush" Color="#FF57D39B" />
            <SolidColorBrush x:Key="ZwfWarningBrush" Color="#FFFFC66D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ZwfCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZwfSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZwfSurfaceMutedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZwfHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZwfStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZwfMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZwfSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZwfWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="PageMaxWidth">1440</x:Double>
    <x:Double x:Key="PagePadding">28</x:Double>
    <Thickness x:Key="PagePaddingThickness">28,24,28,36</Thickness>
    <Thickness x:Key="NarrowPagePaddingThickness">18,18,18,28</Thickness>

    <Style x:Key="ZwfCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ZwfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ZwfStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="ZwfSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource ZwfMutedTextBrush}" />
    </Style>

    <Style x:Key="ZwfMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
</ResourceDictionary>
