<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <WindowsAppSdkVersion>2.3.1</WindowsAppSdkVersion>
    <WindowsSdkBuildToolsVersion>10.0.26100.8249</WindowsSdkBuildToolsVersion>
    <WindowsSdkWinAppVersion>0.5.0</WindowsSdkWinAppVersion>
    <TestSdkVersion>17.12.0</TestSdkVersion>
    <XunitVersion>2.9.2</XunitVersion>
    <XunitRunnerVersion>2.8.2</XunitRunnerVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="$(WindowsSdkBuildToolsVersion)" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="$(WindowsSdkWinAppVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageVersion Include="xunit" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
  </ItemGroup>
</Project>
