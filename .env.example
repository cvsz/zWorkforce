# zWorkforce v2.0.0
ZWORKFORCE_ENV=development
ZWORKFORCE_HOST=0.0.0.0
ZWORKFORCE_PORT=9569
ZWORKFORCE_DATA_DIR=./data
ZWORKFORCE_WORKSPACE_ROOT=.
ZWORKFORCE_DEFAULT_TENANT=default

# secret:role[:tenant[:name[:scope1|scope2]]]
# Use long random secrets in production. Roles: viewer, operator, admin, superadmin.
ZWORKFORCE_API_KEYS=dev-admin:superadmin:default:local-admin:*
ZWORKFORCE_API_RATE_LIMIT_PER_MINUTE=240
ZWORKFORCE_CORS_ORIGINS=

# API and worker can be separated. Use 0 on API nodes when dedicated workers run.
ZWORKFORCE_EMBEDDED_WORKERS=1
ZWORKFORCE_WORKER_POLL_MS=250
ZWORKFORCE_LEASE_SECONDS=60
ZWORKFORCE_LEASE_HEARTBEAT_SECONDS=15
ZWORKFORCE_MAX_ATTEMPTS=3
ZWORKFORCE_RETRY_BASE_SECONDS=2
ZWORKFORCE_MAX_DELEGATION_DEPTH=8

# Legacy single-provider mode. "mock" works without external credentials.
ZWORKFORCE_PROVIDER=mock
ZWORKFORCE_PROVIDER_BASE_URL=https://api.openai.com/v1
ZWORKFORCE_PROVIDER_API_KEY=
ZWORKFORCE_MODEL_SOL=gpt-5.6
ZWORKFORCE_MODEL_TERRA=gpt-5.6-terra
ZWORKFORCE_MODEL_LUNA=gpt-5.6-luna

# Multi-provider mode overrides the legacy fields above. api_key_env reads a separate env var.
# ZWORKFORCE_PROVIDERS_JSON=[{"name":"primary","kind":"openai-compatible","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","priority":10,"models":{"sol":"gpt-5.6","terra":"gpt-5.6-terra","luna":"gpt-5.6-luna"}},{"name":"local","kind":"openai-compatible","base_url":"http://host.docker.internal:11434/v1","api_key":"local","priority":20,"models":{"terra":"qwen3","luna":"qwen3"}}]
ZWORKFORCE_PROVIDER_CIRCUIT_FAILURES=3
ZWORKFORCE_PROVIDER_CIRCUIT_SECONDS=30

# Tool policy. Network tools are deny-by-default. Shell inherits only explicitly allowed env names.
ZWORKFORCE_HTTP_ALLOWLIST=
ZWORKFORCE_HTTP_ALLOW_PRIVATE=false
ZWORKFORCE_HTTP_MUTATING_ENABLED=false
ZWORKFORCE_HTTP_MAX_REDIRECTS=2
ZWORKFORCE_SHELL_ENABLED=false
ZWORKFORCE_SHELL_ALLOWLIST=git,python,python3,node,npm
ZWORKFORCE_SHELL_ENV_ALLOWLIST=PATH,HOME,LANG,LC_ALL,TZ
ZWORKFORCE_TOOL_TIMEOUT_SECONDS=30
ZWORKFORCE_TOOL_MAX_OUTPUT_BYTES=262144
ZWORKFORCE_WORKSPACE_WRITE_MAX_BYTES=1048576
ZWORKFORCE_MAX_REQUEST_BYTES=1048576

# 0 disables the platform-level daily cap. Per-tenant/department/agent budgets are stored in DB.
ZWORKFORCE_GLOBAL_DAILY_BUDGET_CREDITS=0
ZWORKFORCE_SOL_INPUT_CREDITS=125
ZWORKFORCE_SOL_CACHED_CREDITS=12.5
ZWORKFORCE_SOL_OUTPUT_CREDITS=750
ZWORKFORCE_TERRA_INPUT_CREDITS=50
ZWORKFORCE_TERRA_CACHED_CREDITS=5
ZWORKFORCE_TERRA_OUTPUT_CREDITS=300
ZWORKFORCE_LUNA_INPUT_CREDITS=5
ZWORKFORCE_LUNA_CACHED_CREDITS=0.5
ZWORKFORCE_LUNA_OUTPUT_CREDITS=30

# Signed skill registry. Required for skill enforcement in production if skills are used.
ZWORKFORCE_SKILL_SIGNING_KEY=

# Optional identity-aware reverse proxy integration. The proxy must HMAC-sign identity headers.
ZWORKFORCE_TRUST_PROXY_IDENTITY=false
ZWORKFORCE_PROXY_IDENTITY_SECRET=
