ZWORKFORCE_ENV=development
ZWORKFORCE_HOST=0.0.0.0
ZWORKFORCE_PORT=9569
ZWORKFORCE_DATA_DIR=./data
ZWORKFORCE_WORKSPACE_ROOT=.
ZWORKFORCE_MAX_WORKERS=4
ZWORKFORCE_API_KEYS=change-me-admin:admin,change-me-operator:operator
ZWORKFORCE_PROVIDER=mock
ZWORKFORCE_PROVIDER_BASE_URL=https://api.openai.com/v1
ZWORKFORCE_PROVIDER_API_KEY=
ZWORKFORCE_MODEL_SOL=gpt-5.6
ZWORKFORCE_MODEL_TERRA=gpt-5.6-terra
ZWORKFORCE_MODEL_LUNA=gpt-5.6-luna
ZWORKFORCE_SOL_INPUT_CREDITS=125
ZWORKFORCE_SOL_CACHED_CREDITS=12.5
ZWORKFORCE_SOL_OUTPUT_CREDITS=750
ZWORKFORCE_TERRA_INPUT_CREDITS=50
ZWORKFORCE_TERRA_CACHED_CREDITS=5
ZWORKFORCE_TERRA_OUTPUT_CREDITS=300
ZWORKFORCE_LUNA_INPUT_CREDITS=5
ZWORKFORCE_LUNA_CACHED_CREDITS=0.5
ZWORKFORCE_LUNA_OUTPUT_CREDITS=30
ZWORKFORCE_HTTP_ALLOWLIST=
ZWORKFORCE_SHELL_ENABLED=false
ZWORKFORCE_SHELL_ALLOWLIST=git,python,python3,node,npm
ZWORKFORCE_TOOL_TIMEOUT_SECONDS=30
ZWORKFORCE_MAX_REQUEST_BYTES=1048576
ZWORKFORCE_GLOBAL_DAILY_BUDGET_CREDITS=0
