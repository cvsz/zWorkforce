# Runtime
NODE_ENV=development
PORT=5000
PRIMARY_DOMAIN=localhost
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000

# Authentication / crypto
# Any secret can instead be mounted and referenced as NAME_FILE=/run/secrets/name.
SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=86400
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-before-first-production-start
METRICS_TOKEN=replace-with-a-distinct-random-metrics-token

# PostgreSQL
DATABASE_URL=postgres://zeto:replace-password@postgres:5432/zeto
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# Facebook Adapter
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FB_API_VERSION=v19.0
META_API_VERSION=

# AI providers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_SLUG=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
UNSPLASH_ACCESS_KEY=

# Media and notifications
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
DISCORD_WEBHOOK_URL=
LINE_NOTIFY_TOKEN=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=zeto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Automation guardrails
AUTO_PILOT=false
AUTO_PILOT_KILL_SWITCH=true
EMERGENCY_PUBLISHING_KILL_SWITCH=false
MAX_DAILY_PUBLISHES=10
MAX_COST_PER_ASSET_USD=1.00

# Other platform adapters
LINKEDIN_VERSION=
