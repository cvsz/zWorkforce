{
  "id": "dev.zworkforce.zarvis.skill.research.lookup",
  "version": "1.0.0",
  "name": "Bounded Web & Docs Research",
  "domain": "research",
  "description": "SSRF-protected targeted query and documentation retrieval with citation provenance.",
  "input_schema": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": { "type": "string", "minLength": 2 },
      "allowed_domains": { "type": "array", "items": { "type": "string" } }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["findings", "citations"],
    "properties": {
      "findings": { "type": "string" },
      "citations": { "type": "array", "items": { "type": "string" } }
    }
  },
  "capability_allowlist": ["research.query", "research.fetch_doc"],
  "mutability": "read",
  "timeout_seconds": 30,
  "max_concurrency": 5,
  "retry_policy": {
    "max_attempts": 2,
    "backoff": "fixed",
    "base_delay_seconds": 1.0
  },
  "idempotency_strategy": "idempotency_key",
  "audit_events": ["zarvis.research.executed.v1"],
  "owner": "zarvis-research",
  "rollback_policy": "none",
  "tags": ["research", "docs", "provenance"]
}
